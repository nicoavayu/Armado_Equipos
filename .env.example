# Copy this file to `.env.local` for local development.
# `.env` in this repo is intentionally placeholder-only.
# Do not commit real keys.

REACT_APP_SUPABASE_URL=https://example.supabase.co
REACT_APP_SUPABASE_ANON_KEY=replace-with-public-anon-key
REACT_APP_PUBLIC_APP_URL=http://localhost:3000
REACT_APP_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
REACT_APP_SURVEY_FANOUT_MODE=db
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_API_KEY_MOBILE=
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=development
REACT_APP_SENTRY_RELEASE=
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=https://app.posthog.com
REACT_APP_LOCAL_EDIT_MODE=false

# Arma2 Torneos is opt-in and also requires a non-production deploy environment.
# Production forces every Torneos flag off even if a flag is set accidentally.
# Torneos also remains off unless its backend is proven local or matches the
# dedicated staging project ref. Never point this block at the production project.
# Fail closed when this example is copied by CI. Local/staging preview must override it explicitly.
REACT_APP_DEPLOY_ENV=production
REACT_APP_TORNEOS_DATA_ENV=disabled
REACT_APP_TORNEOS_STAGING_PROJECT_REF=
REACT_APP_TORNEOS_ENABLED=false
REACT_APP_TORNEOS_WORKSPACES_ENABLED=false
REACT_APP_TORNEOS_WORKSPACE_SWITCHER_ENABLED=false
REACT_APP_TORNEOS_DEEP_LINKS_ENABLED=false
REACT_APP_TORNEOS_NOTIFICATIONS_ENABLED=false
REACT_APP_TORNEOS_OFFICIAL_STATS_ENABLED=false
REACT_APP_TORNEOS_PUBLIC_PAGES_ENABLED=false
REACT_APP_TORNEOS_SOCIAL_GENERATOR_ENABLED=false

# Multimedia. `MEDIA_ENABLED` depende además de `TORNEOS_ENABLED`, y la subida
# depende de las cinco señales de readiness de abajo: si falta una sola, la
# subida queda apagada aunque el flag esté en true.
REACT_APP_TORNEOS_MEDIA_ENABLED=false
REACT_APP_TORNEOS_MEDIA_UPLOAD_ENABLED=false

# Readiness operativa del pipeline multimedia. No son flags de producto: cada
# una afirma que una pieza de infraestructura está desplegada y verificada.
# Encenderlas sin esa infraestructura no habilita nada útil y sí oculta el
# motivo real por el que la subida no funciona.
REACT_APP_TORNEOS_MEDIA_SIGNER_READY=false
REACT_APP_TORNEOS_MEDIA_WORKER_READY=false
REACT_APP_TORNEOS_MEDIA_AV_READY=false
REACT_APP_TORNEOS_MEDIA_CLEANUP_READY=false
REACT_APP_TORNEOS_MEDIA_OBSERVABILITY_READY=false

# Ref del proyecto de Production. Sirve para que la app RECONOZCA ese backend y
# se apague sola si alguien la apunta ahí; no lo habilita. Dejarlo vacío no
# enciende nada, sólo saca esa red de seguridad.
REACT_APP_PRODUCTION_PROJECT_REF=

# Revisión LOCAL de Torneos: no hace falta copiar ninguno de los valores de
# arriba. `npm run qa:torneos:review -- --start` resuelve el destino del stack
# canónico, fija DATA_ENV=local, LOCAL_EDIT_MODE=false y los quince flags en el
# proceso hijo, y falla si detecta un ref remoto. Los archivos .env* quedan sin
# efecto en esa ruta, que es justamente el punto.

# Optional legacy fallback while old environments are migrated.
# REACT_APP_PUBLIC_APP_ORIGIN=https://app.example.com

# Legacy compatibility only. Prefer REACT_APP_SURVEY_FANOUT_MODE.
# NEXT_PUBLIC_SURVEY_FANOUT_MODE=db
