    "public.can_write_tournament_media_gateway_object(text)",
    "public.can_delete_tournament_media_gateway_object(text)",
    "public.can_read_tournament_media_object(text)",
    "public.begin_tournament_media_gallery_upload(uuid,uuid,text,bigint)",
    "public.complete_tournament_media_gallery_upload(uuid,text,text,bigint,integer,integer,text)",
    "public.fail_tournament_media_gallery_upload(uuid,text)",
    "public.get_tournament_media_read_targets(uuid[],text)"
  ],
  "functions_replaced": [
    "public.tournament_media_storage_contract_status()",
    "public.get_published_tournament_media(uuid,uuid,uuid,integer,integer)"
  ],
  "grants_restored": [
    "public.transition_tournament_media_asset(uuid,text,text)",
    "public.change_tournament_media_gallery_state(uuid,text,text)",
    "public.report_tournament_media_asset(uuid,text,text,boolean,uuid)"
  ],
  "rpcs": [
    "get_tournament_media_admin_context",
    "get_tournament_media_upload_capability",
    "get_tournament_media_asset_processing_tiers",
    "get_tournament_season_media_usage",
    "create_tournament_media_gallery",
    "update_tournament_media_gallery",
    "cancel_tournament_media_upload_session",
    "transition_tournament_media_asset",
    "set_tournament_media_cover",
    "reorder_tournament_media_item",
    "publish_tournament_media_gallery",
    "change_tournament_media_gallery_state",
    "handle_tournament_media_report",
    "get_published_tournament_media",
    "report_tournament_media_asset"
