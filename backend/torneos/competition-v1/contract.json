{
  "phase": "COMPETITION-V1",
  "purpose": "Full-competition contract of the hybrid composition (Core session → exchange → Torneos gateway → Torneos PostgREST). Single source of truth for the gateway allowlist (torneos-gateway/competition-v1-rpc-allowlist.json), the database delta (migrations/00000000000004_competition_v1_rpc_exposure.sql) and the frontend scope (src/features/torneos/foundation/competitionV1Scope.js); guard tests keep them equal.",
  "categories": {
    "ADMIN_OWNER": "Organization staff: the RPC checks a capability of the caller's ACTIVE organization membership (owner/admin; collaborator only for *.read) and, when scope=season, the caller's access to the resource's season (owners always, admins/collaborators only on seasons they are seated on). Communications are the one place where the collaborator role writes: it may draft announcements/documents and preview audiences (announcements.create/update_draft, documents.create/update_draft, audiences.preview), never publish (tournament_communications_role_capabilities).",
    "PRIVATE_AUTHENTICATED": "Any authenticated identity, authorized by its relation to the resource (rostered player, team manager, announcement recipient, hub participant) or only over its own rows (scope=self).",
    "PUBLIC_READ_ONLY": "Anonymous, read-only, served ONLY by the gateway public route as the database role anon, no credential accepted.",
    "SYSTEM_ONLY": "service_role only; never reachable from a client, not in any allowlist."
  },
  "transport": {
    "authenticated": "POST /torneos/rest/v1/rpc/<name>: bridge bearer (RS256, TTL 120 s) verified, live Core session (Core contract), local identity bound; Cache-Control: no-store",
    "public": "POST /torneos/public/v1/rpc/<name>: no Authorization/apikey accepted, JSON body with exactly the declared arguments (≤ 2 KiB), forwarded as anon; Cache-Control: no-store"
  },
