{
  "phase": "OFFICIALIZATION-V1",
  "purpose": "Result officialization for real organizers: dual control becomes an optional per-tournament policy (default OFF) and organizations gain real membership (invite / accept / roles / removal). Single source of truth for the gateway allowlist (torneos-gateway/officialization-v1-rpc-allowlist.json), the database delta (migrations/00000000000005_officialization_v1.sql) and the frontend scope (src/features/torneos/foundation/officializationV1Scope.js); guard tests keep them equal.",
  "root_cause": [
    "make_tournament_match_official requires a validated operation",
    "validate_tournament_match_operation refused submitter = validator unconditionally (TORNEOS_MATCH_DUAL_CONTROL_REQUIRED)",
    "submit / review / validate / make official require an owner/admin (match_operations.* capabilities)",
    "only create_tournament_organization inserted tournament_organization_members (the owner); members.invite/update_role/remove had no RPC and the UI said 'Invitar miembro: Próximamente'",
    "=> no organization could make a result official; standings, statistics, qualification, playoffs, corrections and finishing were blocked"
  ],
  "dual_control": {
    "column": "tournaments.match_result_dual_control_enabled boolean NOT NULL DEFAULT false",
    "off": "an authorized owner/admin (capability match_operations.validate + season access + status under_review + valid payload) may validate the report they submitted; audited as {dualControl:false, selfValidated:true}",
    "on": "the submitter never validates (TORNEOS_MATCH_DUAL_CONTROL_REQUIRED); any other authorized identity may",
    "missing_tournament": "reads as ON (fail closed)",
    "policy_change": "set_tournament_match_dual_control — capability match_operations.configure_dual_control (owner only), season access, refused on completed/archived, ON needs >= 2 eligible validators on the season, audited tournament.match_dual_control_changed",
    "unchanged": "review_tournament_match_operation, make_tournament_match_official, request/create correction keep their certified bodies"
  },
  "roles": {
    "owner": "exactly one per organization (unique index tournament_organization_one_active_owner_idx + trigger protect_tournament_organization_owner); never removed, demoted or self-changed; the only one who grants/changes the admin role and the dual-control policy",
    "admin": "any number; invites collaborators, removes collaborators; cannot grant admin, change roles, remove admins or the owner",
    "collaborator": "any number; read-only on members (no emails), no invitations"
  },
  "features": {
    "organization_members": {
      "frontend_routes": [
        "/torneos/organizacion/:org/miembros",
        "/torneos/invitacion/organizacion/:token"
      ],
      "frontend_components": [
        "OrganizationMembersPage",
        "OrganizationInvitationPage"
      ],
      "rpcs": {
        "list_tournament_organization_members": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": false,
          "authority": "members.read (emails only with members.invite)",
          "db_acl": "granted by 0005",
          "frontend_alias": "listMembers"
        },
        "list_tournament_organization_invitations": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": false,
          "authority": "members.invite",
          "db_acl": "granted by 0005",
          "frontend_alias": "listMemberInvitations"
        },
        "invite_tournament_organization_member": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": true,
          "authority": "members.invite; admin role only by the owner",
          "db_acl": "granted by 0005",
          "frontend_alias": "inviteMember"
        },
        "revoke_tournament_organization_invitation": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": true,
          "authority": "members.invite; admin invitations only by the owner",
          "db_acl": "granted by 0005",
          "frontend_alias": "revokeMemberInvitation"
        },
        "accept_tournament_organization_invitation": {
          "route": "authenticated",
          "category": "PRIVATE_AUTHENTICATED",
          "scope": "self",
          "write": true,
          "authority": "the invited identity: Core verified_email attestation for the invited email (gateway adapter)",
          "db_acl": "granted by 0005",
          "frontend_alias": "acceptOrganizationInvitation",
          "core_contract": "verified_email"
        },
        "update_tournament_organization_member_role": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": true,
          "authority": "members.update_role + owner; never self, never the owner, never 'owner'",
          "db_acl": "granted by 0005",
          "frontend_alias": "updateMemberRole"
        },
        "remove_tournament_organization_member": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "organization",
          "write": true,
          "authority": "members.remove; admins only by the owner; never self, never the owner; releases season seats",
          "db_acl": "granted by 0005",
          "frontend_alias": "removeMember"
        }
      }
    },
    "match_dual_control": {
      "frontend_routes": [
        "/torneos/organizacion/:org/torneo/:t/partidos/:m/revision",
        "/torneos/organizacion/:org/torneo/:t/configuracion"
      ],
      "frontend_components": [
        "MatchOperationsPage",
        "MatchDualControlSettings"
      ],
      "rpcs": {
        "get_tournament_match_dual_control": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "season",
          "write": false,
          "authority": "match_operations.read + season access",
          "db_acl": "granted by 0005",
          "frontend_alias": "loadMatchDualControl"
        },
        "set_tournament_match_dual_control": {
          "route": "authenticated",
          "category": "ADMIN_OWNER",
          "scope": "season",
          "write": true,
          "authority": "match_operations.configure_dual_control (owner) + season access",
          "db_acl": "granted by 0005",
          "frontend_alias": "setMatchDualControl"
        }
      }
    }
  },
