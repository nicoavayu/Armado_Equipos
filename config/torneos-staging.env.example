# Identidad del ambiente. Reemplazar únicamente al provisionar staging real.
REACT_APP_DEPLOY_ENV=staging
REACT_APP_TORNEOS_DATA_ENV=staging
REACT_APP_TORNEOS_STAGING_PROJECT_REF=replace-with-staging-project-ref
REACT_APP_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=replace-with-staging-anon-key

# Todos los switches comienzan fail-closed. Activarlos por gate, nunca en producción.
REACT_APP_TORNEOS_ENABLED=false
REACT_APP_TORNEOS_WORKSPACES_ENABLED=false
REACT_APP_TORNEOS_WORKSPACE_SWITCHER_ENABLED=false
REACT_APP_TORNEOS_DEEP_LINKS_ENABLED=false
REACT_APP_TORNEOS_NOTIFICATIONS_ENABLED=false
REACT_APP_TORNEOS_OFFICIAL_STATS_ENABLED=false
REACT_APP_TORNEOS_PUBLIC_PAGES_ENABLED=false
REACT_APP_TORNEOS_MEDIA_ENABLED=false
REACT_APP_TORNEOS_MEDIA_UPLOAD_ENABLED=false
REACT_APP_TORNEOS_SOCIAL_GENERATOR_ENABLED=false

# Preparación de Media. No son secretos; prueban que cada gate operativo fue aprobado.
TORNEOS_MEDIA_BUCKET=tournament-media
REACT_APP_TORNEOS_MEDIA_SIGNER_READY=false
REACT_APP_TORNEOS_MEDIA_WORKER_READY=false
REACT_APP_TORNEOS_MEDIA_AV_READY=false
REACT_APP_TORNEOS_MEDIA_CLEANUP_READY=false
REACT_APP_TORNEOS_MEDIA_OBSERVABILITY_READY=false
TORNEOS_MEDIA_MAX_UPLOAD_BYTES=12582912
TORNEOS_MEDIA_RETENTION_DAYS=30

# Renovador de la atestación del signer (workers/tournament-media-signer-renewer).
# Sólo nombres: el secreto sale del secret store del host del worker, nunca de este archivo.
# Ninguna de estas variables está configurada ni desplegada todavía.
# TOURNAMENT_MEDIA_EXPECTED_API_HOST=replace-with-staging-project-ref.supabase.co
# TOURNAMENT_MEDIA_FORBIDDEN_API_HOSTS=
# TOURNAMENT_MEDIA_ATTESTATION_SECRET=<secret store>
# TOURNAMENT_MEDIA_GATEWAY_KEY=<credencial pública del gateway; nunca una de servicio>
TOURNAMENT_MEDIA_SIGNER_ATTEST_TTL_SECONDS=3600
TOURNAMENT_MEDIA_RENEW_INTERVAL_SECONDS=1200
TOURNAMENT_MEDIA_RENEW_JITTER_RATIO=0.1
TOURNAMENT_MEDIA_RENEW_TIMEOUT_MS=10000
TOURNAMENT_MEDIA_RENEW_MAX_ATTEMPTS=3
TOURNAMENT_MEDIA_RENEW_BACKOFF_MS=2000
TOURNAMENT_MEDIA_RENEW_BACKOFF_MAX_MS=30000
TOURNAMENT_MEDIA_RENEW_ALERT_AFTER_FAILURES=2
TOURNAMENT_MEDIA_RENEW_SAFETY_MARGIN_SECONDS=900
