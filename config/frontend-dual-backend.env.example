# B04 dual-backend frontend. No URLs, project refs, or credentials belong in this file.
# The existing runtime still consumes the legacy Core pair. Explicit Core aliases must
# match that pair; changing the runtime resolver requires integration review.
REACT_APP_CORE_SUPABASE_URL=
REACT_APP_CORE_SUPABASE_ANON_KEY=
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# The ONE Torneos target: the certified identity gateway (Edge Function
# `torneos-gateway` of the Torneos project, or the local lab bridge). Exchange, RPC
# and the contract's table routes all hang from it. https only (http only on
# loopback), never the Core project origin, never the Production ref.
#
#   set     → /torneos mounts the hybrid composition (Core session → exchange →
#             staging-v1 adapter). Nothing Torneos goes through the Core client.
#   absent  → /torneos opens only with REACT_APP_TORNEOS_DATA_ENV=local (the
#             single-project LOCAL QA stack); staging/preview stay closed.
REACT_APP_TORNEOS_GATEWAY_URL=
