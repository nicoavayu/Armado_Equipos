      "verifyJwt": true,
      "deployOrder": 2,
      "healthContract": "structural pre-flight only; REVOKES any stale processor attestation and never writes one. The Edge runtime has no libvips and no ClamAV, so it cannot pass the processor self-test and is not on the worker type allowlist",
      "healthAuthorization": "x-media-attestation-secret",
      "attests": [],
      "revokesOnHealth": [
        "processor"
      ],
      "attestationTtlSeconds": null,
      "attestationRenewal": "not-applicable",
      "processorAttestationOwner": "workers/tournament-media-processor",
      "rollback": "restore previous recorded release; otherwise revoke attestation and undeploy only with separate approval"
    }
  ],
  "signerAttestationRenewal": {
    "required": true,
    "reason": "the signer only attests while answering its own health probe, so its 3600s attestation cannot renew itself the way the worker loop renews the processor's",
    "path": "workers/tournament-media-signer-renewer",
    "entrypoint": "workers/tournament-media-signer-renewer/src/cli.mjs",
    "runbook": "docs/operations/tournament-media-signer-attestation-renewal.md",
    "attestationTtlSeconds": 3600,
    "intervalSeconds": 1200,
    "jitterRatio": 0.1,
    "timeoutMs": 10000,
    "maxAttempts": 3,
    "backoffBaseMs": 2000,
    "backoffMaxMs": 30000,
    "safetyMarginSeconds": 900,
    "alertAfterConsecutiveFailures": 2,
    "idempotent": true,
    "failClosed": "no code path extends, forges or preserves an attestation; the TTL expiring is the enforcement",
    "holdsServiceCredential": false,
    "secretExposure": "attestation secret stays in the worker host secret store; never in the database, never in CI, never in a public endpoint",
    "scheduler": {
      "configuredInThisChange": false,
      "deployedInThisChange": false,
      "stagingOwner": "the host/orchestrator that already runs workers/tournament-media-processor in Staging, as a sidecar service",
      "productionOwner": "not applicable while Multimedia is forced false in production; same sidecar pattern and a distinct secret when it exists",
      "rejectedAlternatives": [
        "pg_cron plus pg_net, because the attestation secret would have to live inside the database",
        "GitHub Actions cron, because it moves the secret into CI and its schedule granularity does not fit a 3600s window",
        "any publicly callable renewal endpoint, because a renewal without the secret turns the attestation into a rubber stamp"
      ]
    },
    "gatewayCredential": {
      "separateFromAttestationSecret": true,
      "mustSatisfyVerifyJwt": true,
      "reason": "Every Edge Function in this manifest is deployed with verifyJwt true, so the Authorization bearer has to be a JWT the gateway can verify. The attestation secret authorises the renewal itself and is a different credential at a different layer.",
      "acceptedOptions": [
        "TOURNAMENT_MEDIA_GATEWAY_JWT: a dedicated identity JWT with role anon or authenticated (preferred)",
        "SUPABASE_ANON_KEY: the legacy anon key, which is itself a JWT and serves as both apikey and bearer",
        "SUPABASE_PUBLISHABLE_KEY as apikey together with TOURNAMENT_MEDIA_GATEWAY_JWT as bearer"
      ],
      "rejected": [
        "sb_secret_ prefixed keys: service credentials, which this process must never hold",
        "a JWT whose role claim is service_role: the same privilege in JWT form",
        "sb_publishable_ prefixed keys used as the bearer: not a JWT, refused by verify_jwt",
        "any opaque non-JWT string used as the bearer"
      ],
      "validatedLocally": "structure, algorithm, role claim, expiry and project ref; never the signature, which only the gateway can verify, and never by printing the value"
    },
    "gatewayProbe": {
      "entrypoint": "scripts/torneos-staging/signer-gateway-probe.mjs",
      "runbook": "docs/operations/tournament-media-signer-gateway-probe.md",
      "executedInThisChange": false,
      "requiresExplicitAuthorization": true,
      "authorizations": [
        "--i-authorize-attestation-write flag",
        "TORNEOS_PROBE_AUTHORIZATION phrase",
        "--project-ref spelled out"
      ],
      "writes": "one signer attestation row with a 3600s TTL, because the health action is the only endpoint that answers and it attests as part of answering",
      "defaultCommand": "plan, which contacts nothing and prints the request it would make plus the rollback",
      "rollback": "let the 3600s TTL expire, or revoke immediately with revoke_tournament_media_service_attestation(p_service := signer) through the approved flow, then re-read tournament_media_pipeline_readiness() to confirm closure"
    },
    "onceMode": {
      "statePersisted": true,
      "stateFile": "TOURNAMENT_MEDIA_RENEW_STATE_FILE, an absolute path",
      "stateFileMode": "0600",
      "atomicWrites": true,
      "exclusiveLock": true,
      "corruptionFailsClosed": true,
      "contents": "a failure counter, the last success timestamp, the last failure code and an alerting flag; no secret, no response body, no URL",
      "reason": "without persisted state the consecutive-failure counter restarts at zero on every run, so the alert threshold is never reached and the required renewal-failures metric is structurally unreachable",
      "orchestratorAlternative": "Run without a state file and let the scheduler alert on N consecutive non-zero exits (systemd OnFailure, Kubernetes CronJob failure history). The renewer then emits no consecutive-failure metric and the observability catalog entry must be sourced from the orchestrator instead."
    },
    "shutdown": {
      "interruptibleSleep": true,
      "signals": [
        "SIGTERM",
        "SIGINT"
      ],
      "budgetSeconds": 5,
      "notes": "the interval sleep is cancellable, listeners are removed and timers cleared on exit, and the final log line passes through the same redactor as every other"
    },
    "initialSeverity": {
      "unprovableMarginIsCritical": true,
      "notes": "a process with no known last success cannot show any TTL margin; the alert escalates to critical rather than sitting in warning forever"
    }
  },
