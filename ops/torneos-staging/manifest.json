      "verifyJwt": true,
      "deployOrder": 1,
      "healthContract": "probes the private bucket end to end (signed upload, write, signed read, fetch, delete) and writes the signer attestation from what the probe actually demonstrated",
      "healthAuthorization": "x-media-attestation-secret",
      "attests": [
        "signer"
      ],
      "revokesOnHealth": [],
      "attestationTtlSeconds": 3600,
      "attestationRenewal": "external-scheduler-required",
