# Arma2 Torneos · Multimedia Staging runtime — NON-SECRET configuration.
#
# Copy to a host path outside the repository (the systemd unit reads
# /etc/arma2/media-staging/runtime.env) and fill in. Never commit the copy.
#
# ---------------------------------------------------------------------------
# NOTHING IN THIS FILE IS A SECRET, AND NOTHING IN IT MAY BECOME ONE
# ---------------------------------------------------------------------------
# Everything here ends up in the container's `Config.Env`, which means
# `docker inspect` prints it, `/proc/<pid>/environ` carries it, and
# /var/lib/docker/containers/<id>/config.v2.json stores it in clear on disk.
# That is acceptable for a project ref and a poll interval and unacceptable for
# a credential, which is the whole reason the three secrets are mounted as
# files instead. If you find yourself adding a KEY, TOKEN, JWT or SECRET here,
# the answer is a new entry in the `secrets:` block, not a new line here.
#
# test/no-real-secrets.test.mjs fails the suite if a value in this file ever
# looks like a Supabase key or a JWT.

# --- The authorized target -------------------------------------------------
# Named twice on purpose. The processor compares SUPABASE_URL against
# TOURNAMENT_MEDIA_EXPECTED_PROJECT_REF and the renewer compares it against
# TOURNAMENT_MEDIA_EXPECTED_API_HOST; a copy-pasted origin that disagrees with
# either fails at start-up instead of reaching the wrong project.
#
# Staging is project ref hhyvmhgpapyuzjgxfnqv (ops/torneos-staging/manifest.json).
# Production ref rcyuuoaqfwcembdajcss is refused by compiled policy in
# src/target.mjs whatever is written here; there is no value of these variables
# that reaches it.
TOURNAMENT_MEDIA_STAGING_URL=https://hhyvmhgpapyuzjgxfnqv.supabase.co
TOURNAMENT_MEDIA_EXPECTED_PROJECT_REF=hhyvmhgpapyuzjgxfnqv
TOURNAMENT_MEDIA_EXPECTED_API_HOST=hhyvmhgpapyuzjgxfnqv.supabase.co

# --- Identity --------------------------------------------------------------
TOURNAMENT_MEDIA_WORKER_ID=media-worker-staging-1
TOURNAMENT_MEDIA_WORKER_RELEASE=0.1.0
TOURNAMENT_MEDIA_RENEWER_ID=media-signer-renewer-staging-1

# --- Secret FILES, not secret VALUES ---------------------------------------
# The directory on the host holding the three secret files. It has no default:
# `docker compose` refuses to read the manifest until this is set, so there is
# no path where the stack comes up with secrets nobody placed.
#
# Expected contents, each 0400 and owned by uid 1000 (the `node` user inside
# the processor image), each holding the raw value with NO trailing newline:
#
#   supabase_service_role_key   the Staging service-role key   -> processor
#   attestation_secret          the media attestation secret   -> renewer
#   gateway_jwt                 a dedicated anon/authenticated -> renewer
#                               identity JWT for the Functions gateway
#
# The processor must never receive attestation_secret or gateway_jwt, and the
# renewer must never receive supabase_service_role_key. The split is enforced
# per service in docker-compose.staging.yml and asserted by
# test/secrets-model.test.mjs.
ARMA2_MEDIA_SECRET_DIR=/etc/arma2/media-staging/secrets
