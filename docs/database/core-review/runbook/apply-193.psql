-- #193 promotion — applies 20261010120000…139000 on Core, in order, each in its own transaction
-- together with its ledger row (supabase_migrations.schema_migrations). A version already in the
-- ledger is skipped, so the same file resumes after a stop or re-applies after a rollback (the
-- rollbacks remove their ledger row). Run from the repository root, connected as postgres:
--   psql "<conninfo>" --password -X -f docs/database/core-review/runbook/apply-193.psql
-- The first error stops psql: that migration rolls back entirely; the earlier ones stay applied.
-- Generated from the migration files (RUNBOOK-193.md); do not edit by hand.
\set ON_ERROR_STOP on
\timing on
set lock_timeout = '5s';
set statement_timeout = '120s';

do $$
begin
  if current_user <> 'postgres' then
    raise exception 'connect as postgres (now: %)', current_user;
  end if;
end;
$$;

select exists (select 1 from supabase_migrations.schema_migrations where version = '20261010120000') as already_applied \gset
\if :already_applied
\echo '=== 20261010120000 already in the ledger: skipped'
\else
\echo '>>> 20261010120000 core_trigger_helper_execute_grants'
begin;
\i supabase/migrations/20261010120000_core_trigger_helper_execute_grants.sql
\set migration_source `cat supabase/migrations/20261010120000_core_trigger_helper_execute_grants.sql`
insert into supabase_migrations.schema_migrations (version, name, statements) values ('20261010120000', 'core_trigger_helper_execute_grants', array[:'migration_source']);
commit;
\endif

